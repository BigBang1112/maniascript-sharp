<Project>

    <ItemGroup>
        <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
        <CompilerVisibleProperty Include="MSBuildProjectName" />
        <CompilerVisibleProperty Include="ManiaScriptOutputDir" />
        <CompilerVisibleProperty Include="ManiaScriptAdditionalOutputDirs" />
        <CompilerVisibleProperty Include="ManiaScriptIndentSize" />
        <CompilerVisibleProperty Include="ManiaScriptIndentStyle" />
    </ItemGroup>

    <!-- Manialink XML and Razor templates must be visible to the generator as AdditionalFiles so
         edits are tracked as compiler inputs by both Roslyn's incremental cache and MSBuild's
         up-to-date build check. -->
    <ItemGroup>
        <AdditionalFiles Include="**/*.xml" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);bin/**;obj/**" />
        <AdditionalFiles Include="**/*.razor" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);bin/**;obj/**" />
    </ItemGroup>

    <!-- Roslyn analyzer load contexts do not resolve project-reference dependencies from
         deps.json. Listing Razor as an analyzer makes it available both from the packed
         analyzer folder and from this repository's local project-reference output. -->
    <ItemGroup>
        <Analyzer Include="$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Microsoft.AspNetCore.Razor.Language.dll"
                  Condition="Exists('$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Microsoft.AspNetCore.Razor.Language.dll')" />
        <Analyzer Include="$(MSBuildThisFileDirectory)..\bin\$(Configuration)\netstandard2.0\Microsoft.AspNetCore.Razor.Language.dll"
                  Condition="Exists('$(MSBuildThisFileDirectory)..\ManiaScriptSharp.Generator.csproj')" />
    </ItemGroup>

</Project>
