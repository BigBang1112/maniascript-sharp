<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>ManiaScriptSharp.Generator</PackageId>
        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>alpha.4</VersionSuffix>
        <Authors>BigBang1112</Authors>
        <Description>Source generator that translates C# to ManiaScript in real time.</Description>
        <Copyright>Copyright (c) 2026 Petr Pivoňka</Copyright>
        <PackageProjectUrl>https://github.com/BigBang1112/maniascript-sharp</PackageProjectUrl>
        <PackageTags>maniascript;source-generator;roslyn;dotnet;csharp;trackmania;maniaplanet</PackageTags>
        <PackageReleaseNotes>
- Added single-file Razor ManiaApp/Manialink generation
- Added support for different struct field name casing
- Disallowed return assignment expression and other chained assignments
- Improved global variable emitting
        </PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Analyzer project references also need Razor beside the generator assembly. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <PropertyGroup>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
    </PropertyGroup>

    <PropertyGroup>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Suppress: analyzers should not do file IO. We intentionally do it to emit .Script.txt. -->
        <NoWarn>$(NoWarn);CS1591;RS1035;RS2008;RS1032</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Razor.Language" Version="6.0.36" PrivateAssets="all" GeneratePathProperty="true" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(OutputPath)\$(AssemblyName).xml" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(PkgMicrosoft_AspNetCore_Razor_Language)\lib\netstandard2.0\Microsoft.AspNetCore.Razor.Language.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="build\ManiaScriptSharp.Generator.props" Pack="true" PackagePath="build\" />
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ManiaScriptSharp.Generator.Tests" />
    </ItemGroup>

</Project>
