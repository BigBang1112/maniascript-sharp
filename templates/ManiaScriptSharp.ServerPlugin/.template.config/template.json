{
  "$schema": "https://json.schemastore.org/template",
  "author": "ManiaScriptSharp",
  "classifications": [ "Common", "ManiaScript", "TrackMania", "Server" ],
  "identity": "ManiaScriptSharp.ServerPlugin",
  "name": "ManiaScriptSharp Server Plugin",
  "shortName": "msharp-server-plugin",
  "sourceName": "MyServerPlugin",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "Api": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "ManiaPlanet",
          "description": "ManiaPlanet (TM2/SM and later)"
        },
        {
          "choice": "Trackmania",
          "description": "Trackmania (2020+)"
        }
      ],
      "defaultValue": "ManiaPlanet",
      "description": "The target game / ManiaScript API surface package. CServerPlugin is not exposed by the ManiaPlanet3 API."
    },
    "IsManiaPlanet": {
      "type": "computed",
      "value": "(Api == \"ManiaPlanet\")"
    },
    "IsTrackmania": {
      "type": "computed",
      "value": "(Api == \"Trackmania\")"
    }
  },
  "primaryOutputs": [
    { "path": "MyServerPlugin.csproj" }
  ],
  "postActions": [
    {
      "condition": "(true)",
      "description": "Restore NuGet packages",
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
