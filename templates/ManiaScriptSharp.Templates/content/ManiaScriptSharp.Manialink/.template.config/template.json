{
  "$schema": "https://json.schemastore.org/template",
  "author": "ManiaScriptSharp",
  "classifications": [ "Common", "ManiaScript", "TrackMania", "Manialink" ],
  "identity": "ManiaScriptSharp.Manialink",
  "name": "ManiaScriptSharp Manialink",
  "shortName": "msharp-manialink",
  "sourceName": "MyManialink",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "Api": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "ManiaPlanet",
          "description": "ManiaPlanet (TM2/SM and later) — CTmMlScriptIngame or CSmMlScriptIngame"
        },
        {
          "choice": "ManiaPlanet3",
          "description": "ManiaPlanet 3 — CTmMlScriptIngame or CSmMlScriptIngame"
        },
        {
          "choice": "Trackmania",
          "description": "Trackmania (2020+) — always CSmMlScriptIngame"
        }
      ],
      "defaultValue": "ManiaPlanet",
      "description": "The target game / ManiaScript API surface package."
    },
    "IsManiaPlanet": {
      "type": "computed",
      "datatype": "bool",
      "value": "(Api == \"ManiaPlanet\")"
    },
    "IsManiaPlanet3": {
      "type": "computed",
      "datatype": "bool",
      "value": "(Api == \"ManiaPlanet3\")"
    },
    "IsTrackmania": {
      "type": "computed",
      "datatype": "bool",
      "value": "(Api == \"Trackmania\")"
    },
    "BaseClass": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "CTmMlScriptIngame",
          "description": "Trackmania-style ingame manialink"
        },
        {
          "choice": "CSmMlScriptIngame",
          "description": "ShootMania-style ingame manialink"
        }
      ],
      "defaultValue": "CTmMlScriptIngame",
      "description": "Context base class. Only ManiaPlanet/ManiaPlanet3 expose both — ignored (always CSmMlScriptIngame) for Trackmania."
    },
    "UseCSmMode": {
      "type": "computed",
      "datatype": "bool",
      "value": "(IsTrackmania || BaseClass == \"CSmMlScriptIngame\")"
    }
  },
  "primaryOutputs": [
    { "path": "MyManialink.csproj" }
  ],
  "postActions": [
    {
      "condition": "(true)",
      "description": "Restore NuGet packages",
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
