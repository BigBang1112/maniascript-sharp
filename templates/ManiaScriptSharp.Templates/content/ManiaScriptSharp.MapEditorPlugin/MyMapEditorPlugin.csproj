<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <!-- This project is never executed; it only exists so the Roslyn generator runs on its source. -->
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ManiaScriptSharp" Version="*" />
        <PackageReference Include="ManiaScriptSharp.Generator" Version="*" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
<!--#if (IsManiaPlanet) -->
        <PackageReference Include="ManiaScriptSharp.ManiaPlanet" Version="*" />
<!--#endif -->
<!--#if (IsTrackmania) -->
        <PackageReference Include="ManiaScriptSharp.Trackmania" Version="*" />
<!--#endif -->
    </ItemGroup>

</Project>
