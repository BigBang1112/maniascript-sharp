<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <PackageType>Template</PackageType>
        <PackageId>ManiaScriptSharp.Templates</PackageId>
        <Title>ManiaScriptSharp Project Templates</Title>
        <Description>dotnet new templates for scaffolding a ManiaScriptSharp gamemode targeting ManiaPlanet, ManiaPlanet 3, or Trackmania.</Description>
        <PackageTags>dotnet-new;templates;maniascriptsharp;trackmania;maniaplanet</PackageTags>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeSymbols>false</IncludeSymbols>
        <ContentTargetFolders>content</ContentTargetFolders>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <!-- Content files (incl. the template .cs/.csproj) must not be picked up as this project's own compile/project items. -->
        <EnableDefaultItems>false</EnableDefaultItems>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
    </ItemGroup>

</Project>
