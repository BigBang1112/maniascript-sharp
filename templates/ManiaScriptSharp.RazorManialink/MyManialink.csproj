<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
<!--#if (IsTrackmania) -->
        <ManiaScriptVersion>2</ManiaScriptVersion>
<!--#endif -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ManiaScriptSharp" Version="*" />
        <PackageReference Include="ManiaScriptSharp.Generator" Version="*" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
<!--#if (IsManiaPlanet) -->
        <PackageReference Include="ManiaScriptSharp.ManiaPlanet" Version="*" />
<!--#endif -->
<!--#if (IsManiaPlanet3) -->
        <PackageReference Include="ManiaScriptSharp.ManiaPlanet3" Version="*" />
<!--#endif -->
<!--#if (IsTrackmania) -->
        <PackageReference Include="ManiaScriptSharp.Trackmania" Version="*" />
<!--#endif -->
    </ItemGroup>

</Project>
