# Doxygen configuration for ManiaScriptSharp.
# Generates the API reference for all ManiaScriptSharp libraries — the runtime
# (attributes, markers, helpers), the source generator's public entry point, and the
# generated game API surfaces (ManiaPlanet, ManiaPlanet3, Trackmania), including the
# API generator's generated `.g.cs` classes.
#
# Theme: doxygen-awesome-css v2.5.0, installed as a git submodule at
# ./theme/doxygen-awesome-css (repo: https://github.com/jothepro/doxygen-awesome-css).
# Update it with: git submodule update --remote -- docs/doxygen/theme/doxygen-awesome-css
#
# Requires Doxygen >= 1.18.0 (matches the version installed by the docs-pages
# workflow; older distro packages may not support all options used here).

# ─── Project identity ────────────────────────────────────────────────────────

PROJECT_NAME           = "ManiaScriptSharp"
PROJECT_NUMBER         =
PROJECT_BRIEF          = "Write ManiaScript in C# — Roslyn incremental source generator translating C# into ManiaScript."
PROJECT_LOGO           =
INPUT_ENCODING         = UTF-8

# ─── Input ────────────────────────────────────────────────────────────────────

# All ManiaScriptSharp libraries, including the generated API classes
# (src/ManiaScriptSharp.{ManiaPlanet,ManiaPlanet3,Trackmania}/Generated/**/*.g.cs).
INPUT                  = ../../src \
                         ../../docs/event-translation.md \
                         ../../docs/linq-translation.md \
                         ../../docs/ManiaScript-Language-Reference.md \
                         mainpage.md
# Only process C# sources — skip csproj/doc.h/Script.txt inputs.
FILE_PATTERNS          = *.cs
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */bin/* \
                         */obj/* \
                         */Changelogs/* \
                         */build/* \
                         */Properties/*
EXCLUDE_SYMBOLS        = *Tests*

# ─── Language: C# ─────────────────────────────────────────────────────────────

# C#/Java-style output: namespaces become packages, members listed per type.
OPTIMIZE_OUTPUT_JAVA   = YES

# ─── Parser ───────────────────────────────────────────────────────────────────

JAVADOC_AUTOBRIEF      = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_IN_BODY_DOCS      = NO
INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = NO
SORT_MEMBER_DOCS       = YES
SHOW_FILES             = NO
SHOW_INCLUDE_FILES     = NO
SHOW_USED_FILES        = NO
SORT_BY_SCOPE_NAME     = YES

# ─── HTML output ─────────────────────────────────────────────────────────────

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = LIGHT
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 70
HTML_TIMESTAMP         = NO
HTML_DYNAMIC_MENUS      = YES
HTML_DYNAMIC_SECTIONS   = YES
HTML_INDEX_NUM_ENTRIES = 10
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

# doxygen-awesome-css theme (base layout — titlebar + optional treeview),
# provided by the git submodule pinned at v2.5.0.
HTML_EXTRA_STYLESHEET  = theme/doxygen-awesome-css/doxygen-awesome.css \
                         theme/custom.css
# Extensions: dark mode toggle, fragment copy button, paragraph links,
# interactive TOC, tabs.
HTML_EXTRA_FILES       = theme/doxygen-awesome-css/doxygen-awesome-darkmode-toggle.js \
                         theme/doxygen-awesome-css/doxygen-awesome-fragment-copy-button.js \
                         theme/doxygen-awesome-css/doxygen-awesome-paragraph-link.js \
                         theme/doxygen-awesome-css/doxygen-awesome-interactive-toc.js \
                         theme/doxygen-awesome-css/doxygen-awesome-tabs.js

# Custom header template — loads the theme extensions above and inits them.
HTML_HEADER            = theme/header.html

# Theme requires HTML_COLORSTYLE = LIGHT since Doxygen >= 1.9.5.
# (The theme ships its own dark mode via doxygen-awesome-darkmode-toggle.js.)

# ─── Search ───────────────────────────────────────────────────────────────────

SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

# ─── Diagrams ─────────────────────────────────────────────────────────────────

HAVE_DOT               = NO
CLASS_DIAGRAMS         = NO

# ─── Other formats ────────────────────────────────────────────────────────────

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO

# ─── Warnings ─────────────────────────────────────────────────────────────────

WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = NO
WARN_NO_PARAMDOC       = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = html/warnings.log

# ─── Misc ─────────────────────────────────────────────────────────────────────

QUIET                  = YES
ALIASES                = "msnote=ManiaScript note:\x3cbr\x3e"
TOC_INCLUDE_HEADINGS    = 5
USE_MDFILE_AS_MAINPAGE = mainpage.md
