@using ManiaScriptSharp
@using static ManiaScriptSharp.ManiaScript
@namespace MyMode
@inherits CManiaApp
@implements IContext

<manialink version="3">
    <frame pos="0 0">
        <label id="LabelHello" pos="0 0" size="100 10" text="@_title" halign="center" />
    </frame>
</manialink>

@code {
    private string _title = "Razor Manialink";
    private CUILayer? _layer;

    public void Main()
    {
        _layer = UILayerCreate();
        _layer.ManialinkPage = Render();
    }

    public void Loop()
    {
    }

    public class PageScript : CMlScriptIngame, IContext
    {
        [ManialinkControl]
        public required CMlLabel LabelHello;

        public void Main()
        {
            LabelHello.Value = "Ready";
        }

        public void Loop()
        {
        }
    }
}
