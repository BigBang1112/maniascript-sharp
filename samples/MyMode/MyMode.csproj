<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <!-- This project is never executed; it only exists so the Roslyn generator runs on its source. -->
        <OutputType>Library</OutputType>

        <!-- ManiaScriptSharp generator settings -->
        <ManiaScriptOutputDir>out</ManiaScriptOutputDir>
        <ManiaScriptIndentStyle>tabs</ManiaScriptIndentStyle>
        <ManiaScriptIndentSize>1</ManiaScriptIndentSize>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\ManiaScriptSharp\ManiaScriptSharp.csproj" />
        <ProjectReference Include="..\..\src\ManiaScriptSharp.ManiaPlanet\ManiaScriptSharp.ManiaPlanet.csproj" />
        <ProjectReference Include="..\..\src\ManiaScriptSharp.Generator\ManiaScriptSharp.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- When referencing the generator as a NuGet package, build/ManiaScriptSharp.Generator.props
         is imported automatically. For local project references (development), import it explicitly. -->
    <Import Project="..\..\src\ManiaScriptSharp.Generator\build\ManiaScriptSharp.Generator.props" />

</Project>
